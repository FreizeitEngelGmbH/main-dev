# Empty means same-origin /api/* requests (recommended deployment).
VITE_API_BASE_URL=

# Optional legacy content and temporary in-memory Admin/Partner local login.
VITE_USE_MOCK_API=false

# Future backend Google sign-in (server-managed session): path that starts the backend OAuth flow,
# e.g. /api/auth/google. Currently NOT used by the "Mit Google fortfahren" button (see Firebase below).
VITE_GOOGLE_AUTH_START_PATH=

# Firebase Google account selection / profile PREVIEW used by "Mit Google fortfahren".
# Public web-app config from Firebase Console > Project settings > Your apps (environment-specific,
# do not commit real values). No Google client secret belongs in the frontend. Firebase Console also
# needs: Authentication > Sign-in method > Google enabled (with project support email) and
# Authentication > Settings > Authorized domains for localhost, staging and the production domain.
# This preview grants no FreizeitEngel role and creates no server session.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
